# ---- Provider selection ----
# local | openai | claude | gemini | groq | custom
MODEL_PROVIDER=local

# ---- OpenAI (optional) ----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini

# ---- Anthropic / Claude (optional) ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-latest

# ---- Google Gemini (optional) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ---- Groq (optional) ----
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Custom / configurable API (optional) ----
CUSTOM_API_URL=
CUSTOM_API_KEY=
CUSTOM_API_MODEL=
CUSTOM_API_AUTH_HEADER=Authorization
CUSTOM_API_AUTH_PREFIX=Bearer
CUSTOM_API_PROMPT_FIELD=messages
CUSTOM_API_MODEL_FIELD=model
CUSTOM_API_RESPONSE_PATH=choices.0.message.content

# ---- Runtime ----
LOG_LEVEL=INFO
WEAK_DEVICE_MODE=true
# Set to 1 to auto-approve safe shell commands (use with care)
AUTO_APPROVE_SHELL=0

# ---- API server ----
API_TOKEN=
AGENT_DATA_DIR=

# ---- Integrations (optional) ----
# TELEGRAM_TOKEN=
# DISCORD_TOKEN=
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
# GITHUB_TOKEN=
